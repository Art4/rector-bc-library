includes:
  - vendor/phpstan/phpstan-phpunit/extension.neon

parameters:
  level: 10
  treatPhpDocTypesAsCertain: false
  reportUnmatchedIgnoredErrors: false
  paths:
    - src
    - tests
  ignoreErrors:
    - '#Attribute class PHPUnit\\Framework\\Attributes\\DataProvider does not exist\.#'
    - '#Attribute class PHPUnit\\Framework\\Attributes\\Group does not exist\.#'
    # Version-dependent skip in tests: is_a() is statically true or false depending on the installed Rector version
    -
      message: '#Call to function is_a\(\) with .+DeprecatedInterface.+ will always evaluate to (true|false)\.#'
      path: tests/*
  excludePaths:
    - vendor
